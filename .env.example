# === Backend ===
DEBUG=true
ENVIRONMENT=development

# Database (matches docker-compose)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tcgmentor

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth — generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here

# HuggingFace Inference API
# Gere o token em: https://huggingface.co/settings/tokens
HF_TOKEN=hf_...
HF_MODEL=Qwen/Qwen2.5-72B-Instruct

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# === Frontend ===
NEXT_PUBLIC_API_URL=http://localhost:8000

# Free-tier quotas (premium users are unlimited)
FREE_DAILY_MESSAGE_LIMIT=30
FREE_DAILY_DECK_ANALYSES=3

# Card game APIs (defaults are the official free public endpoints)
SCRYFALL_API_URL=https://api.scryfall.com
POKEMONTCG_API_URL=https://api.pokemontcg.io/v2
# Opcional: aumenta o rate limit de 1k para 20k req/dia - https://dev.pokemontcg.io
POKEMONTCG_API_KEY=
YGOPRODECK_API_URL=https://db.ygoprodeck.com/api/v7
LORCAST_API_URL=https://api.lorcast.com/v0
